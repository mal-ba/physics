<!--
  Balance Lab 모델 템플릿.
  {이름} 자리표시자는 src/levels.h 의 난이도 값으로 실행 시 치환됩니다.
-->
<mujoco model="balance">
  <option timestep="0.002" gravity="0 0 -{GRAVITY}">
    <flag contact="disable"/>
  </option>
  <visual>
    <headlight ambient="0.35 0.35 0.35"/>
  </visual>
  <worldbody>
    <light pos="0 -2 4" dir="0 0.5 -1"/>
    <geom type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"/>
    <!-- 받침대 (보기용) -->
    <geom type="box" pos="0 0 {PEDESTAL_HALF}" size="0.04 0.04 {PEDESTAL_HALF}" rgba="0.35 0.35 0.4 1"/>
    <!-- 피벗(관절)은 막대 아래쪽 끝에 위치 -->
    <body name="pole" pos="0 0 {PIVOT}">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="{DAMPING}"/>
      <geom name="pole" type="capsule" fromto="0 0 0 0 0 {LENGTH}" size="{RADIUS}" mass="{MASS}" rgba="0.9 0.4 0.2 1"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="torque" joint="hinge" gear="1" ctrllimited="true" ctrlrange="-{TORQUE} {TORQUE}"/>
  </actuator>
</mujoco>
